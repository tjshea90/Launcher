<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher3 (android-10.0.0_r47, Go flavor, no Quickstep) merged manifest for com.tj.launcher. Changes vs upstream are listed in launcher3/PATCHES.md.
     Licensed under the Apache License 2.0 (AOSP). -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.launcher3">

    <!--
    The manifest defines the common entries that should be present in any derivative of Launcher3.
    The components should generally not require any changes.

    Rest of the components are defined in AndroidManifest.xml which is merged with this manifest
    at compile time. Note that the components defined in AndroidManifest.xml are also required,
    with some minor changed based on the derivative app.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Tj: return reset (all normal, install-time permissions; they work for targetSdk 28 on Android 10) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Tj (V2): lets the launcher switch the keyboard. Cannot be granted from Settings: only `adb shell pm grant` (tools/adb-grant.sh keyboard). Without it the keyboard feature just reports "needs adb grant". -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- C2 (Tj, 2026-11-04): permissions DECLARED IN ADVANCE so `adb shell pm grant` can give them later without a reinstall. Declaring changes nothing: none is granted until Tj runs the adb line
         (research/ADB_COMMANDS.txt, in-app "adb setup guide"). DUMP = read-only dumpsys; CHANGE_CONFIGURATION = font/orientation; PACKAGE_USAGE_STATS + WRITE_SETTINGS = appops "allow";
         REORDER_TASKS and EXPAND_STATUS_BAR are normal permissions (no adb needed). Nothing lock-screen / device-admin / overlay-permission related. -->
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- N6: INTERNET is declared ONLY because Android refuses an app any socket without it, and the optional adb shell helper (research/PROFILES_2026-11-04.md) is reached over loopback TCP
         (127.0.0.1, ports 47631-47635; SELinux forbids apps the shell user's abstract unix socket). No code opens any other address; the helper is off unless Tj starts it with adb. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />   <!-- CB2: is a VPN connected (ConnectivityManager.getAllNetworks / a VPN network callback); a normal permission, granted at install -->
    <uses-permission android:name="android.permission.VIBRATE" />   <!-- N2: a 40 ms buzz when an unlock handshake is accepted -->
    <!-- AA2: a normal permission (granted at install, no adb): lets the keep-alive foreground service run, so the launcher process stays in memory for a faster unlock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />


    <!--
    Permissions required for read/write access to the workspace data. These permission name
    should not conflict with that defined in other apps, as such an app should embed its package
    name in the permissions. eq com.mypackage.permission.READ_SETTINGS
    -->
    <permission
        android:name="${packageName}.permission.READ_SETTINGS"
        android:permissionGroup="android.permission-group.SYSTEM_TOOLS"
        android:protectionLevel="signatureOrSystem"
        android:label="@string/permlab_read_settings"
        android:description="@string/permdesc_read_settings"/>
    <permission
        android:name="${packageName}.permission.WRITE_SETTINGS"
        android:permissionGroup="android.permission-group.SYSTEM_TOOLS"
        android:protectionLevel="signatureOrSystem"
        android:label="@string/permlab_write_settings"
        android:description="@string/permdesc_write_settings"/>

    <uses-permission android:name="${packageName}.permission.READ_SETTINGS" />
    <uses-permission android:name="${packageName}.permission.WRITE_SETTINGS" />

    <!-- BT1f (Tj, 2026-11-11: "in the custom launcher recents list, make the name of the spoof settings "settings" and not "launcher settings""): Android 10's Recents titles a task
         "<application label> <activity label>" unless the two are EQUAL (ActivityManagerWrapper.getBadgedContentDescription), so the look-alike (activity label "Settings") was "Launcher Settings". The application label is
         therefore "Settings" too (tj_app_label, res/values/ss_strings.xml). Every component that should keep the name "Launcher" has its own explicit label: the HOME router and the Launcher activity (derived_app_name).
         Pinned by AppLabelTest. -->
    <application
        android:name="com.tj.launcher.TjApplication"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher_home"
        android:label="@string/tj_app_label"
        android:largeHeap="@bool/config_largeHeap"
        android:supportsRtl="true" >

        <!-- Intent received used to install shortcuts from other applications -->
        <receiver
            android:name="com.android.launcher3.InstallShortcutReceiver"
            android:permission="com.android.launcher.permission.INSTALL_SHORTCUT"
            android:enabled="@bool/enable_install_shortcut_api" >
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>

        <!-- Intent received when a session is committed -->
        <receiver
            android:name="com.android.launcher3.SessionCommitReceiver" >
            <intent-filter>
                <action android:name="android.content.pm.action.SESSION_COMMITTED" />
            </intent-filter>
        </receiver>

        <!-- Intent received used to initialize a restored widget -->
        <receiver android:name="com.android.launcher3.AppWidgetsRestoredReceiver" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED"/>
            </intent-filter>
        </receiver>

        <!-- AO1b (Tj, 2026-11-06: "Attached is what the wallpaper picker should look like ... There should be no my photos option"): the AOSP wallpaper picker (wallpaperpicker/, android-10.0.0_r9) without the
             "My photos" tile. Started only by the long-press > Wallpapers entry (no intent filter, not exported), never listed in Recents, in its OWN process so that nothing inside the old AOSP code can ever take the launcher down or trip the crash breaker. -->
        <activity
            android:name="com.android.wallpaperpicker.WallpaperPickerActivity"
            android:theme="@style/WallpaperTheme.Picker"
            android:label="@string/pick_wallpaper"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":wallpaper_picker"
            android:finishOnCloseSystemDialogs="true" />

        <service
            android:name="com.android.launcher3.uioverrides.dynamicui.WallpaperManagerCompatVL$ColorExtractionService"
            android:exported="false"
            android:process=":wallpaper_chooser"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name="com.android.launcher3.notification.NotificationListener"
            android:label="@string/notification_dots_service_title"
            android:enabled="@bool/notification_dots_enabled"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <meta-data android:name="android.nfc.disable_beam_default"
                       android:value="true" />

        <activity android:name="com.android.launcher3.dragndrop.AddItemActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.Alert"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:label="@string/action_add_to_workspace"
            android:enabled="false" />

        <!--
        Should point to the content provider which can be used to dump Launcher3 compatible
        worspace configuration to the dump's file descriptor by using launcher_dump.proto
        -->
        <meta-data
            android:name="com.android.launcher3.launcher_dump_provider"
            android:value="com.android.launcher3.LauncherProvider" />

        <!--
        The settings provider contains Home's data, like the workspace favorites. The permissions
        should be changed to what is defined above. The authorities should also be changed to
        represent the package name.
        -->
        <provider
            android:name="com.android.launcher3.LauncherProvider"
            android:authorities="${packageName}.settings"
            android:exported="true"
            android:writePermission="${packageName}.permission.WRITE_SETTINGS"
            android:readPermission="${packageName}.permission.READ_SETTINGS" />

        <!--
        The content provider for exposing various launcher grid options.
        TODO: Add proper permissions
        -->
        <provider
            android:name="com.android.launcher3.graphics.GridOptionsProvider"
            android:authorities="${packageName}.grid_control"
            android:enabled="false"
            android:exported="true" />

        <!--
        The settings activity. To extend point settings_fragment_name to appropriate fragment class
        -->
        <activity
            android:name="com.android.launcher3.settings.SettingsActivity"
            android:label="@string/settings_button_text"
            android:theme="@android:style/Theme.DeviceDefault.Settings"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.android.launcher3.testing.TestInformationProvider"
            android:authorities="${packageName}.TestInfo"
            android:readPermission="android.permission.WRITE_SECURE_SETTINGS"
            android:writePermission="android.permission.WRITE_SECURE_SETTINGS"
            android:exported="true"
            android:enabled="false" />

        <!-- Main launcher activity (unchanged from AOSP). -->
        <activity
            android:name="com.android.launcher3.Launcher"
            android:label="@string/derived_app_name"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY"/>
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
            <!-- B1 (Tj: "Launcher must never be listed in Recents"): Android treats an activity started from an implicit MAIN + SECONDARY_HOME intent as a HOME-type task,
                 and HOME-type tasks are never listed in Recents (RecentTasks.isVisibleRecentTask), not even as the most recent task (excluded tasks still are).
                 SECONDARY_HOME is NOT the HOME category the system resolves the default home with, so the preferred-home set (our router) does not change. Same filter AOSP's SecondaryDisplayLauncher has. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.launcher3.grid.control"
                android:value="${packageName}.grid_control" />
        </activity>

        <!-- Tj: the ONLY HOME activity. Invisible; forwards to our Launcher or the stock launcher (RouterActivity). -->
        <activity
            android:name="com.tj.launcher.RouterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:label="@string/derived_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Tj: chooser for the apps shown in the custom launcher (opens only in Quickstep mode; no launcher icon of its own). -->
        <activity
            android:name="com.tj.launcher.HiddenAppsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:label="Apps shown in the custom launcher" />

        <!-- Tj: "Launcher control" icon; reachable from the stock launcher too (switch back, restore everything). -->
        <activity
            android:name="com.tj.launcher.ControlActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:label="Launcher control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- N4: "Back to custom": an app icon (the kill switch) for Quickstep's drawer; never shown in the custom drawer (our own icons are hidden there). -->
        <activity
            android:name="com.tj.launcher.BackToCustomActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:icon="@android:drawable/ic_menu_revert"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:label="Back to custom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- N4: quick-settings tile "Back to custom" (add it with the pencil in Quickstep; tiles are listed in sysui_qs_tiles as custom(com.tj.launcher/.ReturnTile)). -->
        <service
            android:name="com.tj.launcher.ReturnTile"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_revert"
            android:label="Back to custom"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- S2: "Tablet setup & report": the whole adb to-do list on one screen (opens only in Quickstep mode; exported so the emulator test can start it with adb). -->
        <activity
            android:name="com.tj.launcher.SetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:label="Tablet setup and report" />

        <!-- C2: the in-app adb setup guide (opens only in Quickstep mode, from Launcher control). -->
        <activity
            android:name="com.tj.launcher.AdbGuideActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:label="adb setup guide" />

        <!-- BN1 (Tj, 2026-11-09: "Start building the settings spoof app which looks completely identical to the settings app"): the Settings look-alike. ONE page activity (the intent extra names the page), not exported:
             only our own alias and our own rows start it. Its own task affinity keeps its task apart from Launcher control's (which is excluded from Recents). Like the real Settings it is a normal card in Recents
             (label "Settings"; RecentsGuard leaves this task alone). Plan: research/SETTINGS_BUILD_PLAN_2026-11-09.md. -->
        <activity
            android:name="com.tj.launcher.SsPageActivity"
            android:exported="false"
            android:theme="@style/SsTheme"
            android:label="@string/ss_label"
            android:icon="@drawable/ss_ic_launcher"
            android:taskAffinity="com.tj.launcher.settings" />

        <!-- BN1: the drawer entry of the look-alike: label "Settings", the stock Settings icon, a LAUNCHER filter (the drawer lists only components that have one). DISABLED here and in Quickstep mode: SettingsSpoof flips it
             to enabled (PackageManager, DONT_KILL_APP) only in the custom mode while the switch settings_spoof is on, so the stock drawer keeps its single real Settings. AppVisibility.ALWAYS_SHOWN_OWN_COMPONENTS lets it
             through the custom drawer's filter. The name has no class behind it (it is a name only; the target is SsPageActivity). -->
        <activity-alias
            android:name="com.tj.launcher.SettingsAlias"
            android:targetActivity="com.tj.launcher.SsPageActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/ss_label"
            android:icon="@drawable/ss_ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- AA2: keep-alive foreground service (does no work; one silent notification). Started by the router and the accessibility helper, stopped by the switch / Restore everything. -->
        <service
            android:name="com.tj.launcher.KeepAliveService"
            android:exported="false"
            android:label="@string/derived_app_name" />

        <!-- Tj: power-menu helper. Does nothing until Tj turns it on in Settings > Accessibility, and nothing unless a power mode is chosen. -->
        <service
            android:name="com.tj.launcher.TjAccessibilityService"
            android:exported="true"
            android:label="@string/tj_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tj_accessibility" />
        </service>
    </application>
</manifest>
