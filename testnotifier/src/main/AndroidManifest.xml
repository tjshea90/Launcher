<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CI-only test app for the emulator check: shows a line of text and posts one notification each time it is opened; with the boolean extra vpn=true it starts TestVpnService instead (CB2). No permissions. -->
    <application
        android:allowBackup="false"
        android:label="${appLabel}"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name="com.tj.testnotifier.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- CB2 (emulator section vo): a real VPN that routes only 10.111.0.0/24; consent by `appops set ... ACTIVATE_VPN allow` -->
        <service android:name="com.tj.testnotifier.TestVpnService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
        </service>
        <!-- its own task (a different affinity than the main one, which is the package name): see SecondActivity -->
        <activity android:name="com.tj.testnotifier.SecondActivity" android:exported="true" android:taskAffinity="${applicationId}.two" />
    </application>
</manifest>
